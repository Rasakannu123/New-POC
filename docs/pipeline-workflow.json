{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Document Extraction Pipeline - End to End",
    "locale": "en",
    "quality_profile": "showcase",
    "output": "docs/pipeline-workflow.html"
  },
  "lanes": [
    {
      "id": "engine",
      "label": "Pipeline Engine"
    },
    {
      "id": "gate",
      "variant": "exception",
      "label": "Gate & Results"
    }
  ],
  "mainPath": [
    "input",
    "convert",
    "preprocess",
    "assess",
    "route",
    "extract",
    "output"
  ],
  "nodes": [
    {
      "id": "input",
      "lane": "engine",
      "col": 0,
      "type": "external",
      "label": "PDF Documents",
      "sublabel": "data/input + Process",
      "width": 112
    },
    {
      "id": "template",
      "lane": "engine",
      "col": 4,
      "type": "database",
      "label": "Template",
      "sublabel": "Template/test.json",
      "width": 112,
      "yOffset": 96
    },
    {
      "id": "convert",
      "lane": "engine",
      "col": 1,
      "type": "backend",
      "label": "Convert PDF",
      "sublabel": "Poppler, 300 DPI",
      "width": 112
    },
    {
      "id": "preprocess",
      "lane": "engine",
      "col": 2,
      "type": "backend",
      "label": "Enhance Pages",
      "sublabel": "deskew + CLAHE",
      "width": 112
    },
    {
      "id": "assess",
      "lane": "engine",
      "col": 3,
      "type": "backend",
      "label": "Quality Score",
      "sublabel": "focus + OCR -> tier",
      "width": 112
    },
    {
      "id": "split",
      "lane": "gate",
      "col": 3,
      "type": "security",
      "label": "Split Gate",
      "sublabel": "OCR + keyword match",
      "tag": "no_need_page",
      "width": 112
    },
    {
      "id": "route",
      "lane": "engine",
      "col": 4,
      "type": "backend",
      "label": "Model Router",
      "sublabel": "tier -> model",
      "width": 112
    },
    {
      "id": "extract",
      "lane": "engine",
      "col": 5,
      "type": "cloud",
      "label": "Extraction",
      "sublabel": "routed vision model",
      "width": 112
    },
    {
      "id": "skip",
      "lane": "gate",
      "col": 4,
      "type": "database",
      "label": "Skip Folder",
      "sublabel": "page_skipped: true",
      "width": 112
    },
    {
      "id": "review",
      "lane": "gate",
      "col": 4,
      "type": "database",
      "label": "Manual Review",
      "sublabel": "unclear or unreadable",
      "yOffset": 96,
      "width": 112
    },
    {
      "id": "output",
      "lane": "gate",
      "col": 5,
      "type": "database",
      "label": "Output Folder",
      "sublabel": "PNG + JSON records",
      "width": 112
    }
  ],
  "edges": [
    {
      "id": "run",
      "from": "input",
      "to": "convert",
      "label": "process run",
      "role": "main"
    },
    {
      "id": "pages",
      "from": "convert",
      "to": "preprocess",
      "label": "page images",
      "role": "main",
      "route": "straight"
    },
    {
      "id": "enhanced",
      "from": "preprocess",
      "to": "assess",
      "label": "enhanced pages",
      "role": "main"
    },
    {
      "id": "gate-in",
      "from": "preprocess",
      "to": "split",
      "label": "page image",
      "role": "branch"
    },
    {
      "id": "schema",
      "from": "template",
      "to": "extract",
      "label": "field schema",
      "role": "async"
    },
    {
      "id": "markers",
      "from": "template",
      "to": "split",
      "label": "no_need_page fields",
      "role": "async"
    },
    {
      "id": "tier",
      "from": "assess",
      "to": "route",
      "label": "quality tier",
      "role": "main"
    },
    {
      "id": "needed",
      "from": "split",
      "to": "route",
      "label": "no match -> needed",
      "role": "main"
    },
    {
      "id": "skipped",
      "from": "split",
      "to": "skip",
      "label": "keyword matched",
      "role": "branch"
    },
    {
      "id": "unreadable",
      "from": "split",
      "to": "review",
      "label": "no OCR text",
      "role": "error"
    },
    {
      "id": "model",
      "from": "route",
      "to": "extract",
      "label": "selected model",
      "role": "main"
    },
    {
      "id": "record",
      "from": "extract",
      "to": "output",
      "label": "fields + image",
      "role": "main"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Fail-Safe Outcomes",
      "items": [
        "Matched pages skip to data/skip",
        "Unreadable pages park in Manual-Review",
        "Missing template fields return null"
      ]
    },
    {
      "dot": "cyan",
      "title": "Local Decisions",
      "items": [
        "Split gate: normalize, exact, fuzzy >= 0.85",
        "Quality score: 40% focus + 60% OCR",
        "Tiers route clear/blurry/very_blurry to S/M/L"
      ]
    }
  ]
}
