{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Document Extraction Pipeline - Main Workflow",
    "locale": "en",
    "quality_profile": "showcase",
    "output": "docs/main-workflow.html"
  },
  "lanes": [
    { "id": "engine", "label": "Pipeline Engine" },
    { "id": "gate", "label": "Gate & Grouping", "variant": "exception" },
    { "id": "results", "label": "Results Folders" }
  ],
  "mainPath": ["input", "convert", "enhance", "score", "extract", "grouping", "documents"],
  "nodes": [
    { "id": "input", "lane": "engine", "col": 0, "type": "external", "label": "PDF Documents", "sublabel": "data/input + Process", "width": 110 },
    { "id": "convert", "lane": "engine", "col": 1, "type": "backend", "label": "Convert PDF", "sublabel": "Poppler, 300 DPI", "width": 110 },
    { "id": "enhance", "lane": "engine", "col": 2, "type": "backend", "label": "Enhance Pages", "sublabel": "deblur, deskew, CLAHE", "width": 110 },
    { "id": "score", "lane": "engine", "col": 3, "type": "backend", "label": "Quality Score", "sublabel": "focus + OCR -> tier", "width": 110 },
    { "id": "extract", "lane": "engine", "col": 4, "type": "cloud", "label": "Extraction", "sublabel": "routed vision model", "width": 110 },
    { "id": "template", "lane": "gate", "col": 4, "type": "database", "label": "Template", "sublabel": "gate/model/grouping", "width": 110 },
    { "id": "gate", "lane": "gate", "col": 3, "type": "security", "label": "Split Gate", "sublabel": "OCR + keyword match", "width": 110 },
    { "id": "grouping", "lane": "gate", "col": 5, "type": "backend", "label": "Grouping", "sublabel": "value / file name", "tag": "from template", "width": 110 },
    { "id": "skip", "lane": "results", "col": 3, "type": "database", "label": "Skip Folder", "sublabel": "matched pages", "width": 110 },
    { "id": "review", "lane": "results", "col": 4, "type": "database", "label": "Manual Review", "sublabel": "unreadable pages", "width": 110 },
    { "id": "documents", "lane": "results", "col": 5, "type": "database", "label": "Documents", "sublabel": "PDF + merged JSON", "width": 110 }
  ],
  "edges": [
    { "id": "run", "from": "input", "to": "convert", "label": "process run", "role": "main" },
    { "id": "pages", "from": "convert", "to": "enhance", "label": "page images", "role": "main" },
    { "id": "enhanced", "from": "enhance", "to": "score", "label": "enhanced pages", "role": "main" },
    { "id": "gate-in", "from": "enhance", "to": "gate", "label": "page image", "role": "branch" },
    { "id": "tier", "from": "score", "to": "extract", "label": "quality tier", "role": "main" },
    { "id": "needed", "from": "gate", "to": "extract", "label": "no match -> needed", "role": "main" },
    { "id": "template-in", "from": "template", "to": "gate", "label": "markers + schema", "role": "branch" },
    { "id": "skipped", "from": "gate", "to": "skip", "label": "matched", "role": "branch" },
    { "id": "unreadable", "from": "gate", "to": "review", "label": "no OCR text", "role": "error" },
    { "id": "fields-out", "from": "extract", "to": "grouping", "label": "per-page fields", "role": "main" },
    { "id": "ambiguous", "from": "grouping", "to": "review", "label": "ambiguous pages", "role": "error" },
    { "id": "written", "from": "grouping", "to": "documents", "label": "one PDF + JSON", "role": "main" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Fail-Safe Outcomes",
      "items": [
        "Matched pages skip to data/skip, never extracted",
        "Unreadable or ambiguous pages park in Manual-Review"
      ]
    },
    {
      "dot": "cyan",
      "title": "Template & Grouping",
      "items": [
        "data/Template drives the gate markers, the extraction schema, and the grouping field",
        "ON: same helper value joins pages into invoice-N.pdf",
        "OFF: the file name groups all pages into one PDF"
      ]
    }
  ]
}
