API_KEY=your-api-key-here
BASE_URL=https://api.xkiro.com/v1

IMAGE_MODEL_LARGE=mistralai/mistral-large-2512
IMAGE_MODEL_MEDIUM=mistralai/mistral-medium-3.5
IMAGE_MODEL_SMALL=mistralai/mistral-small-2603
IMAGE_MODEL_MINI=mistralai/ministral-14b

TIER_CLEAR_MODEL=mistralai/mistral-small-2603
TIER_BLURRY_MODEL=mistralai/mistral-medium-3.5
TIER_VERY_BLURRY_MODEL=mistralai/mistral-large-2512

DPI=300
IMAGE_FORMAT=png
POPPLER_PATH=

TEMPLATE_PATH=data/Template/test.json

SPLIT_MODEL=qwen/qwen-plus-2025-07-28:free
MANUAL_REVIEW_DIR=data/Manual-Review
SKIP_DIR=data/skip

MAX_CONCURRENT_DOCUMENTS=2
MAX_CONCURRENT_PAGES=4
PREPROCESS_WORKERS=0
ASSESS_WORKERS=4
OCR_CONCURRENCY=4
PIPELINE_MODE=langgraph
CHECKPOINTER=sqlite
CHECKPOINT_DB=data/checkpoints.sqlite

# LangSmith tracing (optional): free account at https://smith.langchain.com
# then Settings -> API Keys -> create key (starts with lsv2_pt_) and uncomment:
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_your-key-here
# LANGSMITH_PROJECT=doc-extractionOCR_CONCURRENCY=4
